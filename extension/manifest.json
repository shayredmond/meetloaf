{
  "manifest_version": 3,
  "name": "MeetLoaf Router",
  "version": "0.2.1",
  "description": "Opens Google Meet links in the MeetLoaf desktop app.",
  "browser_specific_settings": {
    "gecko": {
      "id": "meetloaf@shayredmond.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["webRequest", "webRequestBlocking", "storage", "tabs"],
  "host_permissions": ["*://meet.google.com/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "MeetLoaf Router (enabled)"
  },
  "web_accessible_resources": [
    {
      "resources": ["handoff.html", "handoff.js", "handoff.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
