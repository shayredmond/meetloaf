{
  "manifest_version": 3,
  "name": "MeetLoaf Router",
  "version": "0.2.4",
  "description": "Opens Google Meet links in the MeetLoaf desktop app.",
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MeetLoaf Router",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "handoff.html",
        "handoff.js",
        "handoff.css"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
